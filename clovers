void setup()
{
  size(400, 400);
  noLoop();
  textAlign(CENTER);
}
void draw()
{
  background(0);
  int randy;
  int randx;
  int randl;
  for (int i = 0; i < 100; i++)
  { 
    randl = 3+(int)(Math.random()*2);
    randx= 10+(int)(Math.random()*380);
    randy= 10+(int)(Math.random()*380);
    Clover bob = new Clover(randx,randy,randl);
    bob.show();
  }
}
void mousePressed()
{
  redraw();
}
class Clover
{
  int numLeaves, myX, myY;
  Clover(int x, int y, int l)//constructor
  {
    myX = x;
    myY =y;
    numLeaves = l;
  }
  void show()
  {
    //I used some ugly math below you can ignore it
    fill(0, 255, 0);
    stroke(0, 255, 0);
    if (numLeaves == 3 || numLeaves == 4){
      float rot = random(PI*2);
      translate(myX, myY);
      rotate(rot);
      for (float i = 0; i < PI * 2; i+= PI*2/numLeaves){     
        rotate(i);
        translate(6, 0);
        ellipse(0, 0, 10, 10);
        translate(-6, 0);
        rotate(-i);
      }
      rotate(-rot);
      translate(-myX, -myY );
    } else {
      text("bad # of leaves", myX, myY);
    }
  }
}
